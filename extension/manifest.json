{
  "manifest_version": 3,
  "name": "Line Collector: T Chaos",
  "version": "0.1.0",
  "description": "Live MBTA line Chaos Scores and shutdown alerts from Line Collector, right in your toolbar.",
  "action": { "default_popup": "popup.html", "default_title": "T Chaos", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["http://localhost:8787/*", "https://*/*"],
  "options_page": "popup.html#options"
}
