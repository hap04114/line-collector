# Copy to .env. Everything is optional for local dev: the app runs with an embedded
# database, live MBTA data without a key, and rule-based fallbacks where AI is missing.

# --- server ---
PORT=8787
# Public URL used in sign-in links (https://your-domain on Vultr)
PUBLIC_URL=http://localhost:8787
# Domain Caddy requests certificates for (docker compose)
DOMAIN=
# One-tap demo personas, sample owner page, "simulate being here" toggle. Turn off after judging.
DEMO_MODE=true

# --- Tiger Data (TimescaleDB on Tiger Cloud). Empty = embedded PGlite in .data/ ---
# e.g. postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
DATABASE_URL=

# --- Gemini (Google AI Studio key): photo check, listing check, vibe tags, translation, Mastra agent ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=9000
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- MBTA V3 API (free key raises the rate limit from ~20 to 1000 requests/min) ---
MBTA_API_KEY=
POLLER_ENABLED=true

# --- Sign-in emails (Resend free tier). Without it, sign-in links are shown on screen. ---
RESEND_API_KEY=
EMAIL_FROM=Line Collector <onboarding@resend.dev>
DEV_SHOW_MAGIC_LINK=

# --- RentCast (free developer plan: 50 requests/month; used only by `npm run bake:rent`) ---
RENTCAST_API_KEY=

# --- Solana devnet receipts for reward redemptions (`npm run solana:wallet` prints this) ---
SOLANA_SECRET_KEY=
SOLANA_RPC=https://api.devnet.solana.com

# --- Vultr Object Storage (S3-compatible): sublet photos, private check-in photos, nightly backups ---
VULTR_S3_ENDPOINT=
VULTR_S3_BUCKET=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
